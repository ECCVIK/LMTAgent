{
  "name": "dsh-lmtagent",
  "displayName": "LMTAgent",
  "title": "LMTAgent 研发集群",
  "version": "1.1.0",
  "description": "Multi-agent full-stack dev workbench for DSH: turns feature wishes into parallel file-disjoint coding shards with 8 role presets, standalone pop-out window, one-click Git scope rollback, budget guard & bilingual DAG console.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./store": "./lib/store.js",
    "./ui": "./lib/ui.js",
    "./tools": "./lib/tools.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "skills/browser-automation.md",
    "skills/campaign-planning.md",
    "skills/eng-api-contract-sharding.md",
    "skills/eng-code-review-security.md",
    "skills/eng-fullstack-builder.md",
    "skills/eng-git-recovery.md",
    "skills/eng-release-changelog.md",
    "skills/eng-test-verification-gate.md",
    "skills/eng-ui-design-tokens.md",
    "skills/eng-wish-spec.md",
    "skills/opsec-hygiene.md",
    "skills/supply-chain.md",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "lmtagent",
    "LMTAgent",
    "multi-agent",
    "software-engineering",
    "gstack",
    "workflow-dag",
    "postgresql"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node packages/redteam-bundle/tools/build.mjs",
    "prepublishOnly": "node packages/redteam-bundle/tools/build.mjs --check && node packages/redteam-bundle/tools/test-all.mjs",
    "test": "node packages/redteam-bundle/tools/test-all.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ECCVIK/LMTAgent.git"
  },
  "homepage": "https://github.com/ECCVIK/LMTAgent",
  "bugs": {
    "url": "https://github.com/ECCVIK/LMTAgent/issues"
  },
  "author": "ECCVIK",
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  }
}
